<?xml version="1.0" encoding="utf-8"?>
<!-- Explicit belt-and-braces: allowBackup=false already disables backup on
     every API level; this additionally excludes everything on API < 31,
     where dataExtractionRules does not apply. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
