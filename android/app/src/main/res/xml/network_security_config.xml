<?xml version="1.0" encoding="utf-8"?>
<!-- System trust only. No cleartext, no debug overrides, no user-CA trust. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
