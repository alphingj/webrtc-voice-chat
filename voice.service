[Unit]
Description=Voice chat signaling server (WebRTC over Tailscale)
Documentation=file:///home/gj/voice/README.md
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=gj
Group=gj
WorkingDirectory=/home/gj/voice
ExecStart=/usr/bin/python3 /home/gj/voice/server.py --config /home/gj/voice/config.json
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voice

# The server only needs its own directory writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/gj/voice
UMask=0077

[Install]
WantedBy=multi-user.target
